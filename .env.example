# Environment Variables for Grimbound
# Copy this file to .env.local for local development
# See: https://vitejs.dev/guide/env-and-mode

# Google Fonts API Key (optional)
# Get one at: https://console.cloud.google.com/apis/credentials
# Restrict by HTTP referrer for security (e.g., grimbound.com/*)
# If not provided, the app falls back to a static curated font catalog
VITE_GOOGLE_FONTS_API_KEY=
